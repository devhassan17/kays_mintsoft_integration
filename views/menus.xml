<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- =================================================================== -->
    <!-- Dedicated Configuration Actions for Section 3 Submenus              -->
    <!-- =================================================================== -->
    <record id="action_kays_product_sync_menu" model="ir.actions.act_window">
        <field name="name">Product Synchronization</field>
        <field name="res_model">kays.manual.sync.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_sync_operation': 'fetch_products'}</field>
    </record>

    <record id="action_kays_api_settings_menu" model="ir.actions.act_window">
        <field name="name">API Settings</field>
        <field name="res_model">kays.mintsoft.instance</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_kays_order_settings_menu" model="ir.actions.act_window">
        <field name="name">Order Settings &amp; Status Mappings</field>
        <field name="res_model">kays.mintsoft.status.mapping</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_kays_inventory_settings_menu" model="ir.actions.act_window">
        <field name="name">Inventory Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module': 'kays_mintsoft_integration', 'bin_size': False}</field>
    </record>

    <record id="action_kays_shipping_settings_menu" model="ir.actions.act_window">
        <field name="name">Shipping Settings &amp; Courier Mappings</field>
        <field name="res_model">kays.mintsoft.carrier.mapping</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_kays_webhooks_settings_menu" model="ir.actions.act_window">
        <field name="name">Webhook Configuration &amp; Events</field>
        <field name="res_model">kays.mintsoft.webhook.event</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_kays_advanced_settings_menu" model="ir.actions.act_window">
        <field name="name">Advanced Settings &amp; Job Schedules</field>
        <field name="res_model">kays.mintsoft.job.schedule</field>
        <field name="view_mode">list,form</field>
    </record>

