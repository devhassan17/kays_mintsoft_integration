<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Stock Discrepancy / Stock Difference Dashboard List View (Part H - Section 13) -->
    <record id="view_kays_stock_discrepancy_list" model="ir.ui.view">
        <field name="name">kays.mintsoft.stock.discrepancy.list</field>
        <field name="model">kays.mintsoft.stock.discrepancy</field>
        <field name="arch" type="xml">
            <list string="Stock Differences" multi_edit="1">
                <header>
                    <button name="action_approve_and_apply"
                            string="Approve &amp; Apply Selected Adjustments"
                            type="object"
                            class="btn-primary"/>
                    <button name="action_skip_discrepancy"
                            string="Skip Selected"
                            type="object"
                            class="btn-secondary"/>
                </header>
                <field name="sku" string="SKU"/>
                <field name="product_id" string="Product"/>
                <field name="company_id" string="Company"/>
                <field name="instance_id" string="Connection"/>
                <field name="location_id" string="Odoo Location"/>
                <field name="odoo_on_hand_qty" optional="hide"/>
                <field name="odoo_reserved_qty" optional="hide"/>
                <field name="odoo_available_qty" string="Odoo Available"/>
                <field name="mintsoft_available_qty" string="Mintsoft Available"/>
                <field name="difference_qty" string="Difference"
                       decoration-danger="difference_qty &lt; 0"
                       decoration-warning="difference_qty &gt; 0"/>
                <field name="status" string="Status" widget="badge"
                       decoration-success="status in ('matched', 'adjusted')"
                       decoration-warning="status in ('review', 'pending_approval')"
                       decoration-danger="status == 'error'"/>
                <field name="reason" optional="show"/>
                <field name="adjusted_at" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_kays_stock_discrepancy_form" model="ir.ui.view">
        <field name="name">kays.mintsoft.stock.discrepancy.form</field>
        <field name="model">kays.mintsoft.stock.discrepancy</field>
        <field name="arch" type="xml">
            <form string="Stock Difference Detail">
                <header>
                    <button name="action_approve_and_apply"
                            string="Approve &amp; Apply Adjustment"
                            type="object"
                            class="btn-primary"
                            invisible="status in ('adjusted', 'matched')"/>
                    <button name="action_skip_discrepancy"
                            string="Skip"
                            type="object"
                            class="btn-secondary"
                            invisible="status in ('adjusted', 'skipped')"/>
                    <field name="status" widget="statusbar" statusbar_visible="review,pending_approval,adjusted,skipped,error"/>
                </header>
                <sheet>
                    <group>
                        <group string="Product &amp; Location">
                            <field name="snapshot_id"/>
                            <field name="company_id"/>
                            <field name="instance_id"/>
                            <field name="warehouse_mapping_id"/>
                            <field name="product_mapping_id"/>
                            <field name="product_id"/>
                            <field name="sku"/>
                            <field name="mintsoft_product_id"/>
                            <field name="location_id"/>
                        </group>
                        <group string="Quantity Comparison">
                            <field name="odoo_on_hand_qty"/>
                            <field name="odoo_reserved_qty"/>
                            <field name="odoo_available_qty"/>
                            <field name="mintsoft_on_hand_qty"/>
                            <field name="mintsoft_allocated_qty"/>
                            <field name="mintsoft_available_qty"/>
                            <field name="difference_qty"/>
                            <field name="adjusted_at"/>
                            <field name="adjusted_by"/>
                        </group>
                    </group>
                    <group string="Reason / Audit Note">
                        <field name="reason" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_kays_stock_discrepancy_search" model="ir.ui.view">
        <field name="name">kays.mintsoft.stock.discrepancy.search</field>
        <field name="model">kays.mintsoft.stock.discrepancy</field>
        <field name="arch" type="xml">
            <search string="Search Stock Differences">
                <field name="sku"/>
                <field name="product_id"/>
                <field name="instance_id"/>
                <field name="company_id"/>
                <field name="location_id"/>
                <filter name="filter_review" string="Needs Review / Approval" domain="[('status', 'in', ['review', 'pending_approval'])]"/>
                <filter name="filter_adjusted" string="Adjusted" domain="[('status', '=', 'adjusted')]"/>
                <filter name="filter_error" string="Errors" domain="[('status', '=', 'error')]"/>
                <group>
                    <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"/>
                    <filter name="group_instance" string="Connection" context="{'group_by': 'instance_id'}"/>
                    <filter name="group_status" string="Status" context="{'group_by': 'status'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Stock Snapshot Views -->
    <record id="view_kays_stock_snapshot_list" model="ir.ui.view">
        <field name="name">kays.mintsoft.stock.snapshot.list</field>
        <field name="model">kays.mintsoft.stock.snapshot</field>
        <field name="arch" type="xml">
            <list string="Stock Sync History">
                <field name="name"/>
                <field name="started_at"/>
                <field name="completed_at"/>
                <field name="company_id"/>
                <field name="instance_id"/>
                <field name="sync_mode"/>
                <field name="authority_mode"/>
                <field name="dry_run"/>
                <field name="total_skus_checked"/>
                <field name="matched_count"/>
                <field name="discrepancy_count"/>
                <field name="adjusted_count"/>
                <field name="error_count"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'completed'"
                       decoration-info="state == 'running'"
                       decoration-danger="state == 'failed'"/>
            </list>
        </field>
    </record>

    <record id="view_kays_stock_snapshot_form" model="ir.ui.view">
        <field name="name">kays.mintsoft.stock.snapshot.form</field>
        <field name="model">kays.mintsoft.stock.snapshot</field>
        <field name="arch" type="xml">
            <form string="Stock Sync Snapshot">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="running,completed,failed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Run Metadata">
                            <field name="company_id" readonly="1"/>
                            <field name="instance_id" readonly="1"/>
                            <field name="sync_mode" readonly="1"/>
                            <field name="authority_mode" readonly="1"/>
                            <field name="dry_run" readonly="1"/>
                            <field name="started_at" readonly="1"/>
                            <field name="completed_at" readonly="1"/>
                        </group>
                        <group string="Reconciliation Metrics">
                            <field name="total_skus_checked" readonly="1"/>
                            <field name="matched_count" readonly="1"/>
                            <field name="discrepancy_count" readonly="1"/>
                            <field name="adjusted_count" readonly="1"/>
                            <field name="skipped_count" readonly="1"/>
                            <field name="error_count" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Stock Discrepancies" name="discrepancies_tab">
                            <field name="discrepancy_ids">
                                <list string="Discrepancy Lines">
                                    <field name="sku"/>
                                    <field name="product_id"/>
                                    <field name="location_id"/>
                                    <field name="odoo_available_qty"/>
                                    <field name="mintsoft_available_qty"/>
                                    <field name="difference_qty"/>
                                    <field name="status" widget="badge"/>
                                    <field name="reason"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes_tab">
                            <field name="notes" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Inventory Menu Actions (Part A - Section 3.4) -->
    <record id="action_kays_stock_levels" model="ir.actions.act_window">
        <field name="name">Stock Levels</field>
        <field name="res_model">kays.mintsoft.product.mapping</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('mapping_status', '=', 'matched')]</field>
    </record>

    <record id="action_kays_stock_differences" model="ir.actions.act_window">
        <field name="name">Stock Differences</field>
        <field name="res_model">kays.mintsoft.stock.discrepancy</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_kays_stock_sync_history" model="ir.actions.act_window">
        <field name="name">Stock Sync History</field>
        <field name="res_model">kays.mintsoft.stock.snapshot</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
