<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- =================================================================== -->
    <!-- Stock Picking Extension — Kays Shipment & Tracking Info (Sec 15)    -->
    <!-- =================================================================== -->
    <record id="view_picking_form_inherit_kays_mintsoft" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.kays.mintsoft</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="kays_enabled" invisible="1"/>
                <button name="action_kays_send_to_kays"
                        string="Send Delivery to Kays"
                        type="object"
                        class="btn-primary"
                        invisible="not kays_enabled or picking_type_code != 'outgoing' or state in ('draft', 'cancel') or (kays_order_id and kays_delivery_status not in (False, 'cancelled'))"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Kays Logistics" name="kays_picking_tab" invisible="not kays_enabled and not kays_order_id and not kays_shipment_ids">
                    <div class="mb-3 d-flex gap-2">
                        <button name="action_kays_send_to_kays"
                                string="Send Delivery to Kays"
                                type="object"
                                class="btn-primary"
                                icon="fa-paper-plane"
                                invisible="picking_type_code != 'outgoing' or state in ('draft', 'cancel') or (kays_order_id and kays_delivery_status not in (False, 'cancelled'))"/>
                        <button name="action_kays_refresh_picking_tracking"
                                string="Refresh Kays Tracking &amp; Shipment Status"
                                type="object"
                                class="btn-secondary"
                                icon="fa-refresh"
                                invisible="not kays_order_id"/>
                    </div>
                    <group>
                        <group string="Kays Fulfilment Link">
                            <field name="kays_order_id" readonly="1"/>
                            <field name="mintsoft_shipment_id" readonly="1"/>
                            <field name="kays_delivery_status" widget="badge" readonly="1"/>
                        </group>
                        <group string="Courier &amp; Tracking">
                            <field name="kays_courier_name" readonly="1"/>
                            <field name="kays_tracking_number" readonly="1"/>
                            <field name="kays_tracking_url" widget="url" readonly="1"/>
                            <field name="kays_dispatch_date" readonly="1"/>
                            <field name="kays_last_tracking_update" readonly="1"/>
                        </group>
                    </group>
                    <separator string="Linked Mintsoft Shipments"/>
                    <field name="kays_shipment_ids" readonly="1"/>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
