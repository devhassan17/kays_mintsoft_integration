<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Shipments List & Form Views (Part I - Section 15) -->
    <record id="view_kays_shipment_list" model="ir.ui.view">
        <field name="name">kays.mintsoft.shipment.list</field>
        <field name="model">kays.mintsoft.shipment</field>
        <field name="arch" type="xml">
            <list string="Shipments">
                <header>
                    <button name="action_refresh_tracking_events" string="Refresh Tracking" type="object" class="btn-primary"/>
                </header>
                <field name="name"/>
                <field name="mintsoft_shipment_id"/>
                <field name="kays_order_id"/>
                <field name="sale_order_id"/>
                <field name="picking_id"/>
                <field name="company_id"/>
                <field name="instance_id"/>
                <field name="courier_service_name"/>
                <field name="tracking_number"/>
                <field name="tracking_url" widget="url"/>
                <field name="shipment_date"/>
                <field name="delivery_status" widget="badge"
                       decoration-success="delivery_status in ('dispatched', 'tracking_available', 'delivered')"
                       decoration-info="delivery_status in ('awaiting_dispatch', 'processing', 'in_transit', 'partial_dispatch')"
                       decoration-danger="delivery_status in ('cancelled', 'returned')"/>
                <field name="last_tracking_update"/>
            </list>
        </field>
    </record>

    <record id="view_kays_shipment_form" model="ir.ui.view">
        <field name="name">kays.mintsoft.shipment.form</field>
        <field name="model">kays.mintsoft.shipment</field>
        <field name="arch" type="xml">
            <form string="Kays Shipment">
                <header>
                    <button name="action_refresh_tracking_events" string="Refresh Tracking Events" type="object" class="btn-primary"/>
                    <field name="delivery_status" widget="statusbar" statusbar_visible="awaiting_dispatch,processing,partial_dispatch,dispatched,tracking_available,in_transit,delivered"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Shipment Overview">
                            <field name="mintsoft_shipment_id"/>
                            <field name="kays_order_id"/>
                            <field name="sale_order_id"/>
                            <field name="picking_id"/>
                            <field name="company_id"/>
                            <field name="instance_id"/>
                        </group>
                        <group string="Courier &amp; Tracking">
                            <field name="courier_type"/>
                            <field name="courier_service_id"/>
                            <field name="courier_service_name"/>
                            <field name="tracking_number"/>
                            <field name="tracking_url" widget="url"/>
                            <field name="label_url" widget="url"/>
                            <field name="parcel_numbers"/>
                            <field name="manifested"/>
                            <field name="shipment_date"/>
                            <field name="last_tracking_update"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Tracking Events" name="events_tab">
                            <field name="tracking_event_ids" readonly="1">
                                <list string="Tracking Events">
                                    <field name="event_timestamp"/>
                                    <field name="stage_code"/>
                                    <field name="customer_description"/>
                                    <field name="external_description"/>
                                    <field name="courier_event_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_kays_shipments" model="ir.actions.act_window">
        <field name="name">Shipments</field>
        <field name="res_model">kays.mintsoft.shipment</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Courier Mappings List & Form Views (Part I - Section 14) -->
    <record id="view_kays_carrier_mapping_list" model="ir.ui.view">
        <field name="name">kays.mintsoft.carrier.mapping.list</field>
        <field name="model">kays.mintsoft.carrier.mapping</field>
        <field name="arch" type="xml">
            <list string="Courier Mappings">
                <header>
                    <button name="action_fetch_couriers_from_mintsoft" string="Fetch Couriers from Mintsoft" type="object" class="btn-primary"/>
                </header>
                <field name="name"/>
                <field name="company_id"/>
                <field name="instance_id"/>
                <field name="delivery_carrier_id"/>
                <field name="mintsoft_courier_type_id"/>
                <field name="mintsoft_courier_name"/>
                <field name="mintsoft_service_id"/>
                <field name="mintsoft_service_name"/>
                <field name="region_policy"/>
                <field name="fallback_policy"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_kays_carrier_mapping_form" model="ir.ui.view">
        <field name="name">kays.mintsoft.carrier.mapping.form</field>
        <field name="model">kays.mintsoft.carrier.mapping</field>
        <field name="arch" type="xml">
            <form string="Courier Mapping">
                <header>
                    <button name="action_fetch_couriers_from_mintsoft" string="Fetch Couriers from Mintsoft" type="object" class="btn-secondary"/>
                    <button name="action_fetch_courier_services" string="Fetch Courier Services" type="object" class="btn-secondary"/>
                    <button name="action_test_mapping" string="Test Mapping" type="object" class="btn-primary"/>
                    <button name="action_validate_shipping_service" string="Validate Shipping Service" type="object" class="btn-secondary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Odoo Carrier &amp; Destination Policy">
                            <field name="company_id"/>
                            <field name="instance_id"/>
                            <field name="delivery_carrier_id"/>
                            <field name="region_policy"/>
                            <field name="country_ids" widget="many2many_tags"/>
                            <field name="postcode_prefixes"/>
                            <field name="active"/>
                        </group>
                        <group string="Mintsoft Courier Service &amp; Fallback">
                            <field name="mintsoft_courier_type_id"/>
                            <field name="mintsoft_courier_name"/>
                            <field name="mintsoft_service_id"/>
                            <field name="mintsoft_service_name"/>
                            <field name="tracking_url_template"/>
                            <field name="fallback_policy"/>
                            <field name="fallback_service_id" invisible="fallback_policy != 'use_fallback_service'"/>
                            <field name="fallback_service_name" invisible="fallback_policy != 'use_fallback_service'"/>
                            <field name="last_verified_at"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_kays_carrier_mappings" model="ir.actions.act_window">
        <field name="name">Courier Mappings</field>
        <field name="res_model">kays.mintsoft.carrier.mapping</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
