        <record id="rule_kays_status_mapping_multi_company" model="ir.rule">
            <field name="name">Kays Status Mapping: Multi-Company Rule</field>
            <field name="model_id" ref="model_kays_mintsoft_status_mapping"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_kays_shipment_multi_company" model="ir.rule">
