<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Odoo 19 3-Tier Security Architecture: Category -> Privilege -> Groups -->
        <record id="module_category_kays_logistics" model="ir.module.category">
            <field name="name">Kays Logistics</field>
            <field name="description">Access control for Kays Logistics (Mintsoft) 3PL Integration</field>
            <field name="sequence">25</field>
        </record>

        <record id="res_groups_privilege_kays_logistics" model="res.groups.privilege">
            <field name="name">Kays Logistics</field>
            <field name="category_id" ref="module_category_kays_logistics"/>
            <field name="sequence">10</field>
        </record>

        <!-- Role 1: Kays Integration Viewer -->
        <record id="group_kays_viewer" model="res.groups">
            <field name="name">Kays Integration Viewer</field>
            <field name="privilege_id" ref="res_groups_privilege_kays_logistics"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Read permitted dashboards, order statuses, shipments, stock levels, and logs only.</field>
        </record>

        <!-- Role 2: Kays Integration Manager -->
        <record id="group_kays_manager" model="res.groups">
            <field name="name">Kays Integration Manager</field>
            <field name="privilege_id" ref="res_groups_privilege_kays_logistics"/>
            <field name="implied_ids" eval="[(4, ref('group_kays_viewer'))]"/>
            <field name="comment">Manage sync jobs, mappings, orders, returns, and permitted manual actions without exposing API credentials.</field>
        </record>

        <!-- Role 3: Kays Integration Administrator -->
        <record id="group_kays_admin" model="res.groups">
            <field name="name">Kays Integration Administrator</field>
            <field name="privilege_id" ref="res_groups_privilege_kays_logistics"/>
            <field name="implied_ids" eval="[(4, ref('group_kays_manager')), (4, ref('base.group_system'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
            <field name="comment">Full configuration, API credentials access, production mode activation, and operational control.</field>
        </record>
    </data>

    <!-- Multi-Company Isolation Record Rules (Mandatory Company Isolation) -->
    <data noupdate="1">
        <record id="rule_kays_instance_multi_company" model="ir.rule">
            <field name="name">Kays Connection: Multi-Company Rule</field>
            <field name="model_id" ref="model_kays_mintsoft_instance"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_kays_order_multi_company" model="ir.rule">
            <field name="name">Kays Order: Multi-Company Rule</field>
            <field name="model_id" ref="model_kays_mintsoft_order"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
