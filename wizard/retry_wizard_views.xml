<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_kays_retry_wizard_form" model="ir.ui.view">
        <field name="name">kays.retry.wizard.form</field>
        <field name="model">kays.retry.wizard</field>
        <field name="arch" type="xml">
            <form string="Bulk Reconciliation &amp; Job Retry">
                <div class="alert alert-info" role="status">
                    Orders in <strong>Unknown Outcome</strong> status are always reconciled against Mintsoft first before any retry is attempted.
                </div>
                <group>
                    <field name="company_id"/>
                    <field name="instance_id"/>
                    <field name="target_type" widget="radio"/>
                    <field name="include_dead_letter" invisible="target_type != 'failed_jobs'"/>
                </group>
                <footer>
                    <button name="action_run_retries"
                            string="Execute Reconciliation / Retry"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_kays_retry_wizard" model="ir.actions.act_window">
        <field name="name">Retry Failed Jobs &amp; Orders</field>
        <field name="res_model">kays.retry.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
